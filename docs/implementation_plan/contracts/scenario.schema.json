    "default_backend",
    "default_clock",
    "mode",
    "noise_profile",
    "agents",
    "boxes",
    "orders",
    "objectives_by_camp",
    "events",
    "max_sim_ms",
    "requires",
    "description",
    "sensor_profile_file"
  ],
  "additionalProperties": false
}
