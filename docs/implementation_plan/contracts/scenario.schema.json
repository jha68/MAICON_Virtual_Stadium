              },
              "clock": {
                "enum": [
                  "sim",
                  "match",
                  "reporting"
                ]
              },
              "at_ms": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "const": "robot_command"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "slot": {
                    "enum": [
                      "B-1",
                      "B-2",
                      "B-3",
                      "R-1",
                      "R-2",
                      "R-3"
                    ]
                  },
                  "linear_x_mps": {
                    "type": "number",
                    "minimum": -0.6,
                    "maximum": 0.6
                  },
                  "angular_z_rps": {
                    "type": "number",
                    "minimum": -3,
                    "maximum": 3
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 10
                  }
                },
                "required": [
                  "slot",
                  "linear_x_mps",
                  "angular_z_rps",
                  "duration_ms"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "event_id",
              "clock",
              "at_ms",
              "kind",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "clock": {
                "enum": [
                  "sim",
                  "match",
                  "reporting"
                ]
              },
              "at_ms": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "const": "robot_state_correction"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "slot": {
                    "enum": [
                      "B-1",
                      "B-2",
                      "B-3",
                      "R-1",
                      "R-2",
                      "R-3"
                    ]
                  },
                  "hp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "ammo": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8
                  }
                },
                "required": [
                  "slot"
                ],
                "anyOf": [
                  {
                    "required": [
                      "hp"
                    ]
                  },
                  {
                    "required": [
                      "ammo"
                    ]
                  }
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "event_id",
              "clock",
              "at_ms",
              "kind",
              "parameters"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "max_sim_ms": {
      "type": "integer",
      "minimum": 10
    },
    "requires": {
      "type": "array",
      "items": {
        "enum": [
          "rgb",
          "semantic",
          "lidar",
          "gui"
        ]
      },
